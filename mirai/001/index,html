<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>やさしいAI｜外国人社員の定着を支える、人事の負担軽減インフラ</title>
<meta name="description" content="母国語AIが24時間365日、外国人社員の生活・行政・医療・防災の相談に対応。人事の負担を軽くしながら、定着率を高めるBtoB SaaS「やさしいAI」。">
<meta property="og:title" content="やさしいAI｜辞める前に、気づける会社になる。">
<meta property="og:description" content="外国人を雇用する企業へ。母国語AI＋月次アンケートで人事の負担を軽減し、外国人社員の定着を支えます。">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=M+PLUS+2:wght@500;700;800;900&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --cream:#EEEADA;
  --cream-2:#F8F5E9;
  --white:#FFFFFF;
  --ink:#1C2A31;
  --ink-soft:#5C6E77;
  --line:#E7E1D0;
  --primary:#0C93A3;
  --primary-d:#08606C;
  --primary-l:#E1F1F4;
  --primary-ll:#EFF8FA;
  --yellow:#F0B93E;
  --yellow-d:#D99A1C;
  --yellow-l:#FAF0D6;
  --green:#4FB477;
  --green-l:#E7F5EC;
  --coral:#F2795B;
  --coral-l:#FDE8E2;
  --shadow-sm:0 2px 8px rgba(28,42,49,.06);
  --shadow-md:0 10px 30px rgba(28,42,49,.08);
  --shadow-lg:0 20px 50px rgba(8,96,108,.14);
  --r-sm:12px;
  --r-md:18px;
  --r-lg:26px;
  --r-pill:999px;
  --maxw:1080px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  font-family:"Noto Sans JP",system-ui,sans-serif;
  color:var(--ink);
  background:var(--cream-2);
  line-height:1.8;
  font-size:16px;
  overflow-x:hidden;
}
h1,h2,h3,h4,.disp{font-family:"M PLUS 2","Noto Sans JP",sans-serif;line-height:1.35;letter-spacing:.01em}
.num{font-family:"M PLUS 2",sans-serif;font-weight:800;letter-spacing:-.02em;font-feature-settings:"tnum"}
a{color:inherit;text-decoration:none}
img,svg{display:block;max-width:100%}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 22px}
.sec{padding:76px 0}
.sec-tight{padding:56px 0}
section{position:relative}

/* ---------- eyebrow + section heading ---------- */
.eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-family:"M PLUS 2",sans-serif;font-weight:700;
  font-size:.82rem;letter-spacing:.14em;color:var(--primary-d);
  background:var(--primary-l);padding:7px 16px;border-radius:var(--r-pill);
  margin-bottom:18px;
}
.eyebrow.y{color:var(--yellow-d);background:var(--yellow-l)}
.eyebrow.g{color:#2E8B57;background:var(--green-l)}
.sec-h{font-size:clamp(1.7rem,4.6vw,2.5rem);font-weight:900;letter-spacing:.02em}
.sec-h .mk{color:var(--primary)}
.sec-lead{color:var(--ink-soft);margin-top:14px;font-size:1.02rem;max-width:640px}
.center{text-align:center}
.center .sec-lead{margin-left:auto;margin-right:auto}

/* ---------- buttons ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;
  font-family:"M PLUS 2",sans-serif;font-weight:700;font-size:1.02rem;
  padding:16px 30px;border-radius:var(--r-pill);border:none;cursor:pointer;
  transition:transform .18s ease,box-shadow .18s ease,background .18s ease;
  white-space:nowrap;
}
.btn-primary{background:var(--yellow);color:#4A3400;box-shadow:0 8px 20px rgba(217,154,28,.32)}
.btn-primary:hover{background:var(--yellow-d);transform:translateY(-2px);box-shadow:0 12px 26px rgba(217,154,28,.4)}
.btn-ghost{background:var(--white);color:var(--primary-d);border:1.5px solid var(--primary-l);box-shadow:var(--shadow-sm)}
.btn-ghost:hover{border-color:var(--primary);transform:translateY(-2px)}
.btn-teal{background:var(--primary);color:#fff;box-shadow:0 8px 20px rgba(12,147,163,.3)}
.btn-teal:hover{background:var(--primary-d);transform:translateY(-2px)}
.btn svg{width:18px;height:18px}

/* ---------- header ---------- */
header.site{
  position:sticky;top:0;z-index:60;
  background:rgba(253,251,244,.86);backdrop-filter:blur(12px);
  border-bottom:1px solid var(--line);
}
.nav{display:flex;align-items:center;justify-content:space-between;height:70px}
.brand{display:flex;align-items:center;gap:11px;font-family:"M PLUS 2",sans-serif;font-weight:900;font-size:1.2rem}
.brand .logo{width:38px;height:38px;flex:none}
.brand small{display:block;font-size:.62rem;font-weight:500;color:var(--ink-soft);letter-spacing:.14em;margin-top:-2px}
.nav-links{display:flex;align-items:center;gap:30px}
.nav-links a{font-weight:500;font-size:.95rem;color:var(--ink-soft);transition:color .15s}
.nav-links a:hover{color:var(--primary-d)}
.nav-cta{padding:11px 22px;font-size:.92rem}
.menu-btn{display:none;background:none;border:none;cursor:pointer;padding:8px}

/* ---------- hero ---------- */
.hero{background:var(--cream);overflow:hidden;position:relative}
.hero::after{content:"";position:absolute;inset:0;pointer-events:none;transform-origin:center;background:radial-gradient(520px 340px at 84% 16%,rgba(240,185,62,.14),transparent 68%),radial-gradient(460px 340px at 10% 90%,rgba(79,180,119,.10),transparent 70%),radial-gradient(420px 300px at 60% 70%,rgba(12,147,163,.06),transparent 72%);animation:heroGlow 11s ease-in-out infinite}
@keyframes heroGlow{0%,100%{opacity:.6;transform:scale(1)}50%{opacity:1;transform:scale(1.05)}}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:44px;align-items:center;padding-top:64px;padding-bottom:78px;position:relative;z-index:1}
.hero-tag{font-family:"M PLUS 2",sans-serif;font-weight:700;color:var(--primary-d);letter-spacing:.04em;font-size:.95rem;margin-bottom:14px}
.hero-badges{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:22px}
.hbadge{display:inline-flex;align-items:center;gap:7px;background:var(--white);border:1px solid var(--line);
  padding:8px 15px;border-radius:var(--r-pill);font-size:.82rem;font-weight:700;color:var(--primary-d);box-shadow:var(--shadow-sm)}
.hbadge .dot{width:7px;height:7px;border-radius:50%;background:var(--green)}
.hero h1{font-size:clamp(2.1rem,6vw,3.5rem);font-weight:900;letter-spacing:.01em;line-height:1.3}
.hero h1 .hl{position:relative;color:var(--primary-d);white-space:nowrap}
.hero h1 .hl::after{content:"";position:absolute;left:-2px;right:-2px;bottom:.08em;height:.32em;background:var(--yellow);opacity:.55;z-index:-1;border-radius:4px}
.hero-price{display:inline-flex;align-items:baseline;gap:6px;margin-top:20px;background:var(--white);
  padding:12px 20px;border-radius:var(--r-md);box-shadow:var(--shadow-sm);border:1px solid var(--line);font-weight:700}
.hero-price .num{font-size:1.9rem;color:var(--coral)}
.hero-price small{font-size:.78rem;color:var(--ink-soft);font-weight:500}
.hero-sub{margin-top:22px;font-size:1.05rem;color:#3a4a52;max-width:520px}
.hero-cta{display:flex;flex-wrap:wrap;gap:14px;margin-top:30px}
.hero-micro{margin-top:16px;font-size:.85rem;color:var(--ink-soft);display:flex;align-items:center;gap:8px}
.hero-micro svg{width:16px;height:16px;color:var(--green)}
.hero-art{position:relative}
.hero-art .hero-img{width:100%;height:auto;border-radius:var(--r-lg);border:1px solid var(--line);box-shadow:var(--shadow-md);background:#fff}

/* ---------- trust strip ---------- */
.trust{background:var(--white);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.trust .wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:14px 34px;padding:22px}
.trust span{font-size:.88rem;color:var(--ink-soft);font-weight:500;display:inline-flex;align-items:center;gap:9px}
.trust .num{color:var(--primary-d);font-size:1.15rem}

/* utility */
.tag{display:inline-block;font-size:.7rem;font-weight:700;padding:4px 11px;border-radius:var(--r-pill)}

/* ---------- concerns ---------- */
.concerns{background:var(--cream)}
.concern-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:44px}
.concern{background:var(--white);border:1px solid var(--line);border-radius:var(--r-md);padding:26px 24px;box-shadow:var(--shadow-sm);transition:transform .2s,box-shadow .2s;position:relative}
.concern:hover{transform:translateY(-4px);box-shadow:var(--shadow-md)}
.concern .ci{width:56px;height:56px;border-radius:16px;background:var(--primary-l);display:flex;align-items:center;justify-content:center;margin-bottom:16px}
.concern .ci svg{width:30px;height:30px;color:var(--primary-d)}
.concern h3{font-size:1.08rem;font-weight:700;margin-bottom:8px}
.concern p{font-size:.92rem;color:var(--ink-soft);line-height:1.7}
.concern .qbadge{position:absolute;top:20px;right:22px;font-family:"M PLUS 2";font-weight:800;font-size:1.4rem;color:var(--primary-l)}
.cimg{display:block;border-radius:var(--r-md);overflow:hidden}
.cimg img{width:100%;height:auto;display:block}
.feat-full{padding:10px 0}
.feat-full img{width:100%;height:auto;display:block;border-radius:var(--r-lg)}
.feat-illus{background:none;border:none;box-shadow:none;padding:0;position:relative;min-height:320px}
.feat-illus img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center;display:block}
.concern-note{text-align:center;margin-top:40px;font-size:1.05rem;font-weight:700}
.concern-note .arrow{display:inline-flex;align-items:center;gap:10px;background:var(--yellow-l);color:var(--yellow-d);padding:12px 26px;border-radius:var(--r-pill)}

/* ---------- results ---------- */
.results{background:linear-gradient(180deg,var(--primary-d),#063F48);color:#fff;overflow:hidden}
.results .eyebrow{background:rgba(255,255,255,.14);color:#fff}
.results .sec-h{color:#fff}
.results .sec-lead{color:rgba(255,255,255,.82)}
.result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:46px}
.rcard{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);border-radius:var(--r-lg);padding:34px 26px;text-align:center;backdrop-filter:blur(4px)}
.rcard .big{font-family:"M PLUS 2";font-weight:800;font-size:clamp(3rem,9vw,4.4rem);line-height:1;letter-spacing:-.01em}
.rcard .unit{font-size:.5em;font-weight:700;font-family:"Noto Sans JP",sans-serif;letter-spacing:0}
.rcard .pre{font-size:.42em;font-weight:700;font-family:"Noto Sans JP",sans-serif;letter-spacing:0;margin-right:2px;vertical-align:.14em}
.rcard.y .big{color:var(--yellow)}
.rcard.g .big{color:#7FE0A6}
.rcard.c .big{color:#8FE6F0}
.rcard .rlabel{margin-top:12px;font-weight:700;font-size:1.02rem}
.rcard .rsub{margin-top:6px;font-size:.84rem;color:rgba(255,255,255,.7)}
.result-strip{margin-top:34px;display:flex;justify-content:center}
.result-strip .pill{background:var(--yellow);color:#4A3400;font-weight:800;font-size:1.1rem;padding:16px 34px;border-radius:var(--r-pill);display:inline-flex;align-items:center;gap:12px;box-shadow:0 12px 30px rgba(0,0,0,.2)}
.result-strip .pill .num{font-size:1.35rem}

/* ---------- features ---------- */
.features{background:var(--cream-2)}
.feat{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:stretch;padding:44px 0}
.feat.rev .feat-media{order:2}
.feat-num{font-family:"M PLUS 2";font-weight:800;font-size:.95rem;color:var(--primary);letter-spacing:.1em}
.feat h3{font-size:clamp(1.4rem,4vw,1.9rem);font-weight:900;margin:10px 0 16px}
.feat-list{list-style:none;margin-top:20px;display:flex;flex-direction:column;gap:13px}
.feat-list li{display:flex;gap:12px;font-size:.98rem;line-height:1.6}
.feat-list li .ck{flex:none;width:26px;height:26px;border-radius:50%;background:var(--green-l);display:flex;align-items:center;justify-content:center;margin-top:2px}
.feat-list li .ck svg{width:15px;height:15px;color:var(--green)}
.feat-result{margin-top:22px;background:linear-gradient(120deg,var(--green-l),var(--primary-ll));border:1px solid #D6E9DD;border-radius:16px;padding:17px 20px;position:relative;overflow:hidden}
.feat-result::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--green)}
.feat-result .fr-label{display:inline-flex;align-items:center;gap:8px;font-family:"M PLUS 2",sans-serif;font-weight:800;font-size:.78rem;letter-spacing:.05em;color:#2E8B57;margin-bottom:8px}
.feat-result .fr-label svg{width:16px;height:16px}
.feat-result .fr-text{font-size:.96rem;line-height:1.75;color:var(--ink)}
.feat-result .fr-text b{color:var(--primary-d);font-weight:800}
.feat-result .fr-metric{display:inline-block;margin-top:11px;background:#fff;border:1px solid var(--line);border-radius:var(--r-pill);padding:7px 15px;font-family:"M PLUS 2",sans-serif;font-weight:700;font-size:.83rem;color:var(--primary-d);box-shadow:var(--shadow-sm)}
.feat-result .fr-metric .num{font-family:"M PLUS 2",sans-serif;font-weight:800;color:var(--coral)}
.feat-media{background:var(--white);border:1px solid var(--line);border-radius:var(--r-lg);padding:26px;box-shadow:var(--shadow-md)}
.feat-media svg{width:100%;height:auto}

/* ---------- before/after ---------- */
.ba{background:var(--cream)}
.ba-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:0;margin-top:44px;align-items:stretch}
.ba-col{border-radius:var(--r-lg);padding:32px 28px}
.ba-before{background:#EAE3D2;border:1px solid var(--line)}
.ba-after{background:linear-gradient(160deg,var(--primary-l),#fff);border:1.5px solid var(--primary)}
.ba-col h4{display:flex;align-items:center;gap:10px;font-size:1.15rem;font-weight:900;margin-bottom:20px}
.ba-before h4{color:#9A8B72}
.ba-after h4{color:var(--primary-d)}
.ba-col .tg{font-size:.7rem;padding:4px 10px;border-radius:var(--r-pill)}
.ba-before .tg{background:#E4DAC6;color:#8A795E}
.ba-after .tg{background:var(--yellow);color:#4A3400}
.ba-row{display:flex;flex-direction:column;gap:4px;padding:14px 0;border-top:1px dashed rgba(0,0,0,.09)}
.ba-row:first-of-type{border-top:none}
.ba-row .k{font-size:.78rem;color:var(--ink-soft);font-weight:700}
.ba-row .v{font-size:1.05rem;font-weight:700}
.ba-before .v{color:#7A6B54}
.ba-after .v{color:var(--ink)}
.ba-mid{display:flex;align-items:center;justify-content:center;padding:0 18px}
.ba-mid .circ{width:52px;height:52px;border-radius:50%;background:var(--yellow);display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-md)}
.ba-mid svg{width:26px;height:26px;color:#4A3400}

/* ---------- ROI ---------- */
.roi{background:var(--white)}
.roi-table{margin-top:40px;border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-md);border:1px solid var(--line)}
table.tbl{width:100%;border-collapse:collapse;font-size:.98rem}
table.tbl th,table.tbl td{padding:16px 18px;text-align:center;border-bottom:1px solid var(--line)}
table.tbl thead th{background:var(--primary-d);color:#fff;font-family:"M PLUS 2";font-weight:700;font-size:.92rem}
table.tbl tbody th{background:var(--primary-l);color:var(--primary-d);font-weight:700;text-align:left}
table.tbl tbody tr:last-child td,table.tbl tbody tr:last-child th{border-bottom:none}
table.tbl .pos{color:var(--green);font-weight:800}
table.tbl .num{font-size:1.05rem}
.roi-note{margin-top:16px;font-size:.8rem;color:var(--ink-soft)}
.roi-cta{margin-top:24px;text-align:center;font-weight:800;font-size:1.15rem;color:var(--primary-d)}

/* ---------- pricing ---------- */
.pricing{background:var(--cream)}
.price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:44px;align-items:stretch}
.pcard{background:var(--white);border:1px solid var(--line);border-radius:var(--r-lg);padding:32px 28px;box-shadow:var(--shadow-sm);position:relative;display:flex;flex-direction:column}
.pcard.reco{border:2px solid var(--yellow);box-shadow:var(--shadow-lg);transform:translateY(-6px)}
.pcard .rec-tag{position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--yellow);color:#4A3400;font-weight:800;font-size:.78rem;padding:6px 18px;border-radius:var(--r-pill)}
.pcard .pk{font-size:1rem;font-weight:700;color:var(--primary-d);margin-bottom:6px}
.pcard .pp{font-family:"M PLUS 2";font-weight:800;font-size:2.5rem;color:var(--ink);line-height:1.1}
.pcard .pp .u{font-size:.44em;color:var(--ink-soft);font-weight:700;font-family:"M PLUS 2"}
.pcard .pd{font-size:.86rem;color:var(--ink-soft);margin-top:8px}
.price-ex{margin-top:30px;background:var(--white);border:1px dashed var(--primary);border-radius:var(--r-md);padding:22px 26px;display:flex;flex-wrap:wrap;gap:14px 34px;justify-content:center;align-items:center}
.price-ex .ex{text-align:center}
.price-ex .ex .k{font-size:.8rem;color:var(--ink-soft);font-weight:700}
.price-ex .ex .v{font-family:"M PLUS 2";font-weight:800;font-size:1.5rem;color:var(--primary-d)}
.price-ex .ex .v span{font-size:.55em;font-family:"M PLUS 2"}
.campaign{margin-top:24px;text-align:center}
.campaign .pill{background:var(--green);color:#fff;font-weight:800;padding:14px 30px;border-radius:var(--r-pill);display:inline-flex;align-items:center;gap:10px}

/* ---------- area & languages ---------- */
.area{background:var(--white)}
.lang-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-top:36px}
.lang{background:var(--cream-2);border:1px solid var(--line);border-radius:var(--r-md);padding:16px 10px;text-align:center;transition:transform .18s}
.lang:hover{transform:translateY(-3px)}
.lang svg{width:40px;height:28px;margin:0 auto 8px;border-radius:5px;box-shadow:var(--shadow-sm)}
.lang span{font-size:.82rem;font-weight:700}
.area-box{margin-top:40px;background:linear-gradient(160deg,var(--primary-l),var(--cream-2));border-radius:var(--r-lg);padding:34px;text-align:center;border:1px solid var(--line)}
.area-box h4{font-size:1.15rem;font-weight:900;color:var(--primary-d);margin-bottom:18px}
.area-chips{display:flex;flex-wrap:wrap;justify-content:center;gap:10px}
.area-chip{background:var(--white);border:1px solid var(--line);padding:10px 20px;border-radius:var(--r-pill);font-weight:700;font-size:.95rem;box-shadow:var(--shadow-sm);display:inline-flex;align-items:center;gap:8px}
.area-chip svg{width:16px;height:16px;color:var(--coral)}
.area-more{margin-top:16px;font-size:.85rem;color:var(--ink-soft)}

/* ---------- steps ---------- */
.steps{background:var(--cream)}
.step-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-top:46px;position:relative}
.step{text-align:center;position:relative}
.step .sn{width:64px;height:64px;margin:0 auto 16px;border-radius:50%;background:var(--white);border:2px solid var(--primary);display:flex;align-items:center;justify-content:center;position:relative;z-index:2;box-shadow:var(--shadow-sm)}
.step .sn svg{width:30px;height:30px;color:var(--primary)}
.step .snum{position:absolute;top:-6px;right:calc(50% - 40px);width:24px;height:24px;border-radius:50%;background:var(--yellow);color:#4A3400;font-family:"M PLUS 2";font-weight:800;font-size:.85rem;display:flex;align-items:center;justify-content:center;z-index:3}
.step h4{font-size:1rem;font-weight:700;margin-bottom:6px}
.step p{font-size:.82rem;color:var(--ink-soft);line-height:1.6}
.step::after{content:"";position:absolute;top:32px;left:50%;width:100%;height:2px;background:repeating-linear-gradient(90deg,var(--primary) 0 6px,transparent 6px 12px);opacity:.4;z-index:1}
.step:last-child::after{display:none}

/* ---------- FAQ ---------- */
.faq{background:var(--white)}
.faq-list{max-width:760px;margin:44px auto 0}
.faq-item{border:1px solid var(--line);border-radius:var(--r-md);margin-bottom:14px;background:var(--cream-2);overflow:hidden;transition:box-shadow .2s}
.faq-item[open]{box-shadow:var(--shadow-md);background:var(--white)}
.faq-item summary{list-style:none;cursor:pointer;padding:20px 24px;display:flex;align-items:center;gap:14px;font-weight:700;font-size:1rem}
.faq-item summary::-webkit-details-marker{display:none}
.faq-item summary .q{flex:none;width:28px;height:28px;border-radius:8px;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;font-family:"M PLUS 2";font-weight:800;font-size:.9rem}
.faq-item summary .chev{margin-left:auto;transition:transform .25s;color:var(--primary)}
.faq-item[open] summary .chev{transform:rotate(180deg)}
.faq-item .a{padding:0 24px 22px 66px;color:var(--ink-soft);font-size:.94rem;line-height:1.8}

/* ---------- company ---------- */
.company{background:var(--cream)}
.comp-table{max-width:720px;margin:40px auto 0;background:var(--white);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-sm)}
.comp-row{display:grid;grid-template-columns:180px 1fr;border-bottom:1px solid var(--line)}
.comp-row:last-child{border-bottom:none}
.comp-row .ck{background:var(--primary-l);color:var(--primary-d);font-weight:700;padding:16px 22px;font-size:.9rem}
.comp-row .cv{padding:16px 22px;font-size:.95rem}
.comp-row .cv a{color:var(--primary-d);text-decoration:underline}

/* ---------- contact ---------- */
.contact{background:linear-gradient(165deg,var(--primary-d),#0A5560);color:#fff}
.contact .eyebrow{background:rgba(255,255,255,.16);color:#fff}
.contact-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:44px;margin-top:20px;align-items:start}
.contact h2{color:#fff;font-size:clamp(1.7rem,4.6vw,2.4rem);font-weight:900}
.contact-lead{color:rgba(255,255,255,.85);margin-top:14px;font-size:1.02rem}
.contact-info{margin-top:28px;display:flex;flex-direction:column;gap:16px}
.cinfo{display:flex;align-items:center;gap:14px}
.cinfo .ci{width:46px;height:46px;border-radius:14px;background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;flex:none}
.cinfo .ci svg{width:22px;height:22px;color:#fff}
.cinfo .k{font-size:.76rem;color:rgba(255,255,255,.65);font-weight:700}
.cinfo .v{font-size:1.1rem;font-weight:700}
.form-card{background:#fff;border-radius:var(--r-lg);padding:34px;box-shadow:var(--shadow-lg)}
.form-card h3{color:var(--ink);font-size:1.2rem;font-weight:900;margin-bottom:6px}
.form-card .fsub{color:var(--ink-soft);font-size:.88rem;margin-bottom:22px}
.field{margin-bottom:16px}
.field label{display:block;font-size:.84rem;font-weight:700;color:var(--ink);margin-bottom:7px}
.field label .req{color:var(--coral);font-size:.72rem;margin-left:5px}
.field input,.field textarea{width:100%;padding:13px 15px;border:1.5px solid var(--line);border-radius:var(--r-sm);font-family:inherit;font-size:.95rem;color:var(--ink);background:var(--cream-2);transition:border .15s}
.field input:focus,.field textarea:focus{outline:none;border-color:var(--primary);background:#fff}
.field textarea{resize:vertical;min-height:90px}
.f2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.consent{display:flex;align-items:flex-start;gap:10px;font-size:.82rem;color:var(--ink-soft);margin:6px 0 18px}
.consent input{margin-top:3px;flex:none;width:17px;height:17px;accent-color:var(--primary)}
.consent a{color:var(--primary-d);text-decoration:underline}
.form-card .btn{width:100%}
.form-note{margin-top:14px;font-size:.76rem;color:var(--ink-soft);text-align:center}
.thanks{display:none;text-align:center;padding:30px 10px}
.thanks.on{display:block}
.thanks .tk-ic{width:70px;height:70px;margin:0 auto 18px;border-radius:50%;background:var(--green-l);display:flex;align-items:center;justify-content:center}
.thanks .tk-ic svg{width:38px;height:38px;color:var(--green)}
.thanks h3{color:var(--ink);font-size:1.3rem;margin-bottom:10px}
.thanks p{color:var(--ink-soft);font-size:.92rem}

/* ---------- footer ---------- */
footer.site{background:#132228;color:rgba(255,255,255,.7);padding:50px 0 120px}
.foot-grid{display:flex;flex-wrap:wrap;gap:30px;justify-content:space-between;align-items:flex-start}
.foot-brand{display:flex;align-items:center;gap:12px;color:#fff;font-family:"M PLUS 2";font-weight:900;font-size:1.2rem}
.foot-brand .logo{width:40px;height:40px}
.foot-desc{margin-top:14px;font-size:.86rem;max-width:340px;line-height:1.8}
.foot-links{display:flex;gap:44px;flex-wrap:wrap}
.foot-col h5{color:#fff;font-size:.9rem;font-weight:700;margin-bottom:14px}
.foot-col a{display:block;font-size:.86rem;margin-bottom:10px;color:rgba(255,255,255,.7);transition:color .15s}
.foot-col a:hover{color:var(--primary)}
.foot-bottom{margin-top:40px;padding-top:24px;border-top:1px solid rgba(255,255,255,.1);font-size:.8rem;display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between}

/* ---------- sticky mobile CTA ---------- */
.sticky-cta{position:fixed;bottom:0;left:0;right:0;z-index:70;background:rgba(253,251,244,.94);backdrop-filter:blur(10px);border-top:1px solid var(--line);padding:12px 16px calc(12px + env(safe-area-inset-bottom));display:none;gap:10px;box-shadow:0 -6px 20px rgba(0,0,0,.06)}
.sticky-cta .btn{flex:1;padding:14px 10px;font-size:.95rem}
.sticky-cta .tel{flex:none;width:52px;padding:0;background:var(--primary-l);border-radius:var(--r-pill);display:flex;align-items:center;justify-content:center}
.sticky-cta .tel svg{width:22px;height:22px;color:var(--primary-d)}

/* ---------- responsive ---------- */
@media(max-width:920px){
  .feat{align-items:center}
  .feat-illus{position:static;min-height:0}
  .feat-illus img{position:static;height:auto;object-fit:initial}

  .hero-grid{grid-template-columns:1fr;gap:30px}
  .hero-art{max-width:440px;margin:0 auto;order:-1}
  .feat{grid-template-columns:1fr;gap:28px}
  .feat.rev .feat-media{order:0}
  .contact-grid{grid-template-columns:1fr;gap:30px}
  .concern-grid,.result-grid,.price-grid{grid-template-columns:1fr 1fr}
  .step-grid{grid-template-columns:1fr 1fr 1fr}
  .step::after{display:none}
  .lang-grid{grid-template-columns:repeat(4,1fr)}
}
@media(max-width:640px){
  .sec{padding:56px 0}
  .nav-links{position:fixed;top:70px;left:0;right:0;background:var(--cream-2);flex-direction:column;align-items:stretch;gap:0;padding:10px 22px 22px;border-bottom:1px solid var(--line);box-shadow:var(--shadow-md);transform:translateY(-140%);transition:transform .3s;z-index:55}
  .nav-links.open{transform:translateY(0)}
  .nav-links a{padding:14px 4px;border-bottom:1px solid var(--line)}
  .nav-cta{margin-top:12px;text-align:center;border-bottom:none!important}
  .menu-btn{display:block}
  .concern-grid,.result-grid,.price-grid,.step-grid,.lang-grid{grid-template-columns:1fr 1fr}
  .pcard.reco{transform:none}
  .ba-grid{grid-template-columns:1fr;gap:16px}
  .ba-mid{transform:rotate(90deg);padding:4px}
  .f2{grid-template-columns:1fr}
  .comp-row{grid-template-columns:110px 1fr}
  .price-ex{flex-direction:column;gap:16px}
  .roi-table{overflow-x:auto}
  .sticky-cta{display:flex}
  .hero-cta .btn{flex:1}
  .foot-links{gap:28px}
}
@media(max-width:400px){
  .concern-grid,.result-grid,.price-grid,.lang-grid,.step-grid{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
